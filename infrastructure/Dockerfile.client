# Client Dockerfile
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY client/package*.json ./client/
COPY server/package*.json ./server/
COPY shared/package*.json ./shared/

# Install the exact reviewed dependency graph.
RUN npm ci

COPY client ./client
COPY shared ./shared

WORKDIR /app/client
RUN npm run build

EXPOSE 4028

CMD ["npm", "start"]

# Server Dockerfile
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY client/package*.json ./client/
COPY server/package*.json ./server/
COPY shared/package*.json ./shared/

# Install the exact reviewed dependency graph.
RUN npm ci

COPY server ./server
COPY shared ./shared

WORKDIR /app/server
RUN npm run build

EXPOSE 3001

CMD ["npm", "start"]
